<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Philips_HUE_Lampen.DetailView">
    <VerticalStackLayout>
        <Label x:Name="nameLabel" Text="name"/>
        <Label Text="Hue :"/>
        <Entry x:Name="HueEntry" Keyboard="Numeric" />
        <Label Text="Brightness :"/>
        <Entry x:Name="BriEntry" Keyboard="Numeric" />
        <Label Text="Saturation :"/>
        <Entry x:Name="SatEntry" Keyboard="Numeric" />

        <Button x:Name="UpdateLampButton"
                Text="Update Lamp"
                Clicked="UpdateLampButton_Clicked"/>

        <Label Text="Status :"/>
        <Button x:Name="PowerButton"
                Text="Powerbutton"
                Clicked="PowerButton_Clicked"/>
        
        
    </VerticalStackLayout>
</ContentPage>
